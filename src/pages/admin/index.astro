---
import { getCollection } from "astro:content";
import desktop1 from "@assets/images/DesktopWallpaper/d1.avif";
import desktop2 from "@assets/images/DesktopWallpaper/d2.avif";
import desktop3 from "@assets/images/DesktopWallpaper/d3.avif";
import desktop4 from "@assets/images/DesktopWallpaper/d4.avif";
import desktop5 from "@assets/images/DesktopWallpaper/d5.avif";
import desktop6 from "@assets/images/DesktopWallpaper/d6.avif";
import mobile1 from "@assets/images/MobileWallpaper/m1.avif";
import mobile2 from "@assets/images/MobileWallpaper/m2.avif";
import mobile3 from "@assets/images/MobileWallpaper/m3.avif";
import mobile4 from "@assets/images/MobileWallpaper/m4.avif";
import mobile5 from "@assets/images/MobileWallpaper/m5.avif";
import mobile6 from "@assets/images/MobileWallpaper/m6.avif";
import AdminShell from "@components/admin/AdminShell.svelte";

const desktopWallpapers = [
	desktop1.src,
	desktop2.src,
	desktop3.src,
	desktop4.src,
	desktop5.src,
	desktop6.src,
];
const mobileWallpapers = [
	mobile1.src,
	mobile2.src,
	mobile3.src,
	mobile4.src,
	mobile5.src,
	mobile6.src,
];
const posts = await getCollection("posts");
const initialPosts = posts.map((post, index) => {
	const fallbackCover = desktopWallpapers[index % desktopWallpapers.length];
	const image = post.data.image || "";
	return {
		id: post.id,
		title: post.data.title,
		slug: post.id.replace(/\.(md|mdx)$/, "").replace(/\/index$/, ""),
		status: post.data.draft ? ("draft" as const) : ("published" as const),
		published: post.data.published.toISOString().slice(0, 10),
		updated: (post.data.updated || post.data.published)
			.toISOString()
			.slice(0, 10),
		description: post.data.description || "还没有添加文章摘要。",
		tags: post.data.tags || [],
		category: post.data.category || "未分类",
		cover:
			image.startsWith("http") || image.startsWith("/") ? image : fallbackCover,
		content: post.body || "",
		views: 120 + index * 87,
		comments: index % 4,
	};
});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>管理后台 · Firefly</title>
	</head>
	<body>
		<AdminShell
			client:load
			initialPosts={initialPosts}
			desktopWallpapers={desktopWallpapers}
			mobileWallpapers={mobileWallpapers}
		/>
	</body>
</html>
