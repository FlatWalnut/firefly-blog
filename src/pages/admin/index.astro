---
import { getCollection } from "astro:content";
import desktop1 from "@assets/images/DesktopWallpaper/d1.avif";
import desktop2 from "@assets/images/DesktopWallpaper/d2.avif";
import desktop3 from "@assets/images/DesktopWallpaper/d3.avif";
import desktop4 from "@assets/images/DesktopWallpaper/d4.avif";
import desktop5 from "@assets/images/DesktopWallpaper/d5.avif";
import desktop6 from "@assets/images/DesktopWallpaper/d6.avif";
import mobile1 from "@assets/images/MobileWallpaper/m1.avif";
import mobile2 from "@assets/images/MobileWallpaper/m2.avif";
import mobile3 from "@assets/images/MobileWallpaper/m3.avif";
import mobile4 from "@assets/images/MobileWallpaper/m4.avif";
import mobile5 from "@assets/images/MobileWallpaper/m5.avif";
import mobile6 from "@assets/images/MobileWallpaper/m6.avif";
import AdminShell from "@components/admin/AdminShell.svelte";

const desktopWallpapers = [
	desktop1.src,
	desktop2.src,
	desktop3.src,
	desktop4.src,
	desktop5.src,
	desktop6.src,
];
const mobileWallpapers = [
	mobile1.src,
	mobile2.src,
	mobile3.src,
	mobile4.src,
	mobile5.src,
	mobile6.src,
];
const posts = await getCollection("posts");
const initialPosts = posts.map((post, index) => {
	const fallbackCover = desktopWallpapers[index % desktopWallpapers.length];
	const image = post.data.image || "";
	return {
		id: post.id,
		title: post.data.title,
		slug: post.id.replace(/\.(md|mdx)$/, "").replace(/\/index$/, ""),
		status: post.data.draft ? ("draft" as const) : ("published" as const),
		published: post.data.published.toISOString().slice(0, 10),
		updated: (post.data.updated || post.data.published)
			.toISOString()
			.slice(0, 10),
		description: post.data.description || "还没有添加文章摘要。",
		tags: post.data.tags || [],
		category: post.data.category || "未分类",
		cover:
			image.startsWith("http") || image.startsWith("/") ? image : fallbackCover,
		content: post.body || "",
		views: 120 + index * 87,
		comments: index % 4,
	};
});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>管理后台 · Firefly</title>
		<style>
			.login-mask {
				position: fixed; inset: 0; z-index: 9999;
				display: flex; align-items: center; justify-content: center;
				background: #0a0a0a; font-family: system-ui, sans-serif;
			}
			.login-mask.hidden { display: none; }
			.box { background: #1a1a2e; border: 1px solid #2a2a3e; border-radius: 12px; padding: 2.5rem; width: 320px; text-align: center; }
			h2 { color: #e0e0e0; margin: 0 0 1.5rem; font-size: 1.3rem; }
			input { width: 100%; box-sizing: border-box; padding: 0.7rem 1rem; border: 1px solid #3a3a5e; border-radius: 8px; background: #12122a; color: #e0e0e0; font-size: 0.95rem; outline: none; }
			input:focus { border-color: #6ee7b7; }
			button { width: 100%; margin-top: 1rem; padding: 0.7rem; border: none; border-radius: 8px; background: #6ee7b7; color: #0a0a0a; font-size: 0.95rem; font-weight: 600; cursor: pointer; }
			button:hover { background: #34d399; }
			.err { color: #f87171; font-size: 0.85rem; margin-top: 0.8rem; }
		</style>
	</head>
	<body>
		<div class="login-mask" id="loginMask">
			<div class="box">
				<h2>管理后台</h2>
				<input type="password" id="pwdInput" placeholder="请输入密码" autofocus />
				<button id="loginBtn">登录</button>
				<p class="err" id="errMsg" style="display:none">密码错误，请重试</p>
			</div>
		</div>
		<AdminShell client:load initialPosts={initialPosts} desktopWallpapers={desktopWallpapers} mobileWallpapers={mobileWallpapers} />
		<script is:inline>
			(function () {
				const KEY = "admin_auth";
				const HASH = "wuJIA1130";
				const mask = document.getElementById("loginMask");
				const input = document.getElementById("pwdInput");
				const btn = document.getElementById("loginBtn");
				const err = document.getElementById("errMsg");

				if (sessionStorage.getItem(KEY) === HASH) {
					mask.classList.add("hidden");
					return;
				}

				btn.addEventListener("click", function () {
					if (input.value === HASH) {
						sessionStorage.setItem(KEY, HASH);
						mask.classList.add("hidden");
					} else {
						err.style.display = "";
					}
				});
				input.addEventListener("keydown", function (e) {
					if (e.key === "Enter") btn.click();
				});
			})();
		</script>
	</body>
</html>
